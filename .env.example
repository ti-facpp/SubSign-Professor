# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP para envio dos e-mails (Google Workspace: senha de app do Google).
# Sem SMTP_HOST/SMTP_USER/SMTP_PASS o envio é apenas simulado.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="assinatura@facpp.edu.br"
SMTP_PASS="SENHA_DE_APP"
SMTP_FROM="SubSign Professor FACPP <assinatura@facpp.edu.br>"

# Modo de teste: redireciona TODOS os e-mails para este endereço (o paciente, o aluno e a
# coordenação NÃO recebem nada). Em produção deixe VAZIO para enviar aos destinatários reais.
# A tela de e-mail mostra um aviso amarelo enquanto este modo estiver ligado.
EMAIL_REDIRECIONAR_PARA=""

# Coordenação da disciplina (3º destinatário do PDF assinado, junto com paciente e aluno).
# Normalmente vem junto com o prontuário do app do aluno (campo coordenacaoEmail). Quando não vier:
# 1) EMAIL_COORDENACAO_POR_DISCIPLINA: JSON {"trecho do nome da disciplina": "email"}
#    (ex.: {"odontopediatria":"odontopediatria@facpp.edu.br"}); já existem padrões para
#    Bucomaxilofacial, Periodontia, Dentística e Endodontia.
# 2) EMAIL_COORDENACAO_PADRAO: usado quando nenhuma disciplina bate.
EMAIL_COORDENACAO_PADRAO="clinica.odontologia@facpp.edu.br"
EMAIL_COORDENACAO_POR_DISCIPLINA=""
